.env
**/.env
**/.env.local
**/.env.production

# Build artifacts
**/dist/
**/build/
**/.turbo/

# Large archives
*.tar.gz
*.zip

# DB files
*.db
*.sqlite

# Logs
logs/
**/*.log

# Docker volumes data
data/postgres/
data/redis/

# OS files
.DS_Store
Thumbs.db

# Large images (will add sophia-avatar separately)
.env.backup.txt

# Archive folder for pre-mainnet cleanup (kept local only)
_archive_pre_mainnet/

# Embedded deploy repo metadata (deploy source is now tracked here)
deploy/.git/

# Large media (108+ files, 1.1GB+ — synced separately to VPS)
MFP-ART/

# Reports + crontab dumps
reports/
crontab-backup.txt
pm2-dump.json

# Ảnh chụp chỉ-đọc và bản sao lưu biên tập. Chưa từng được theo dõi; một lần
# `git add -A` ngày 18/08/2026 đã kéo 123 file _archive (kèm một git repo lồng
# nhau, commit thành gitlink hỏng) và 52 file .bak vào index — 83 MB. Chặn ở đây
# để lần sau không lặp lại.
_archive/
_archive_*/
TEMP/
_VPS_Backup_*/
*.bak
*.bak-*
*.bak2-*
*.bak.*
_bk_*/
_wp_bk_*/
